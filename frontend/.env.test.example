# DuoFocus frontend — TEST environment template (Firebase Emulator Suite)
# Copy to .env.test and adjust if needed. This file is SAFE to commit:
# it contains NO real Firebase credentials — the emulators require none.
#
# The test environment NEVER reaches production Firebase: with the emulator
# flag set, the Web SDK is wired to 127.0.0.1 emulators (see
# frontend/src/services/firebase.ts) and the dummy config below never
# leaves the local machine.

# Explicit, deterministic emulator gate (required for the test environment)
VITE_USE_FIREBASE_EMULATORS=true

# Emulator API keys can be any non-empty string; the Auth emulator
# (currently) and Firestore emulator do not validate them.
VITE_FIREBASE_API_KEY=test-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=duofocus-test

# Remaining values are required by the App identity shape but unused by the
# emulators; kept as placeholders so the config object stays complete.
VITE_FIREBASE_STORAGE_BUCKET=duofocus-test.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=1:0:web:test
