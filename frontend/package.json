{
  "name": "duofocus-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore",
    "test": "vitest run",
    "verify:tests": "vitest run && npm run verify:types",
    "verify:types": "tsc -p tests/tsconfig.json",
    "regression": "firebase emulators:exec --only auth,firestore --project duofocus-test \"npm run verify:tests && npm run build\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^13.35.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.2",
    "vite": "^5.4.10",
    "vitest": "^4.1.11"
  }
}
