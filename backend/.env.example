# DuoFocus backend — environment template
# Copy to .env and fill in real values. NEVER commit the real .env.

# Base URL / CORS (defaults to http://localhost:5173 for local frontend)
FRONTEND_ORIGIN=http://localhost:5173

# Firebase Admin configuration (do NOT commit service account keys)
# Set GOOGLE_APPLICATION_CREDENTIALS to the local path of your service account json file,
# or ensure Application Default Credentials (ADC) are configured in your environment.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
