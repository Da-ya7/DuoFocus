rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Path builders for getAfter()/existsAfter() cross-document checks.
    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }
    function codePath(code) {
      return /databases/$(database)/documents/roomCodes/$(code);
    }
    function completionPath(roomId, compId) {
      return /databases/$(database)/documents/rooms/$(roomId)/completions/$(compId);
    }

    // ------------------------------------------------------------------
    // roomCodes/{roomCode} — lookup only. Maps a human room code to a
    // room document ID. Contains NO membership data.
    // ------------------------------------------------------------------
    match /roomCodes/{code} {

      // Single-code lookup for the join flow. Codes cannot be enumerated.
      allow get: if signedIn();

      allow list: if false;

      // A code may only be claimed together with the room it points to.
      // The room must NOT exist before the batch and MUST exist after it —
      // this forbids squatter code docs pointing at pre-existing rooms.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['roomId'])
        && request.resource.data.keys().hasAll(['roomId'])
        && request.resource.data.roomId is string
        && request.resource.data.roomId.size() > 0
        && !exists(roomPath(request.resource.data.roomId))
        && existsAfter(roomPath(request.resource.data.roomId));

      // Codes are immutable once claimed.
      allow update: if false;

      // A code may only be deleted as the paired half of a final-member
      // leave: the caller must be the sole current member of the linked
      // room, and the room must be deleted in the SAME batched write.
      // get()/existsAfter() evaluate server-side with full privileges.
      allow delete: if signedIn()
        && get(roomPath(resource.data.roomId)).data.memberIds == [request.auth.uid]
        && !existsAfter(roomPath(resource.data.roomId));
    }

    // ------------------------------------------------------------------
    // rooms/{roomId} — the two-person study room.
    // ------------------------------------------------------------------
    match /rooms/{roomId} {

      function timerValid(next, prev) {
        return next.keys().hasOnly(['status', 'remainingSeconds', 'transitionedAt'])
          && next.keys().hasAll(['status', 'remainingSeconds', 'transitionedAt'])
          && next.transitionedAt == request.time
          && next.remainingSeconds is int
          && next.remainingSeconds >= 0
          && next.remainingSeconds <= 3600
          && (
               // Start: idle -> running, remaining preserved (idle holds the
               // configured duration, 25:00).
               (prev.status == 'idle' && next.status == 'running'
                 && next.remainingSeconds == prev.remainingSeconds
                 && prev.remainingSeconds == 1500)
               // Pause: running -> paused. The stored remaining must be at
               // least 1 s and can NEVER exceed the true remaining at commit
               // (request.time, no grace) — pause can only decrease time.
               || (prev.status == 'running' && next.status == 'paused'
                 && next.remainingSeconds >= 1
                 && next.remainingSeconds * 1000
                      <= prev.transitionedAt.toMillis()
                         + prev.remainingSeconds * 1000
                         - request.time.toMillis())
               // Resume: paused -> running, remaining preserved EXACTLY.
               || (prev.status == 'paused' && next.status == 'running'
                 && next.remainingSeconds == prev.remainingSeconds)
               // Complete: only after true server-side expiry; zero remaining.
               || (prev.status == 'running' && next.status == 'completed'
                 && next.remainingSeconds == 0
                 && prev.transitionedAt.toMillis()
                      + prev.remainingSeconds * 1000
                      <= request.time.toMillis())
               // Reset: any active/completed state -> idle, default restored.
               || (prev.status in ['running', 'paused', 'completed']
                 && next.status == 'idle'
                 && next.remainingSeconds == 1500)
             );
      }

      // Members only. Covers both get and member-scoped list queries.
      allow read: if signedIn()
        && request.auth.uid in resource.data.memberIds;

      // A room is only created together with its roomCodes document.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['roomCode', 'ownerId', 'memberIds', 'createdAt', 'timer'])
        && request.resource.data.keys().hasAll(['roomCode', 'ownerId', 'memberIds', 'createdAt', 'timer'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.roomCode is string
        && request.resource.data.roomCode.matches('^[2-9A-HJ-NP-Z]{6}$')
        && request.resource.data.createdAt == request.time
        && request.resource.data.timer.keys().hasOnly(['status', 'remainingSeconds', 'transitionedAt'])
        && request.resource.data.timer.keys().hasAll(['status', 'remainingSeconds', 'transitionedAt'])
        && request.resource.data.timer.status == 'idle'
        && request.resource.data.timer.remainingSeconds == 1500
        && request.resource.data.timer.transitionedAt == request.time
        && getAfter(codePath(request.resource.data.roomCode)).data.roomId == roomId;

      // Updates may ONLY touch memberIds (join/leave shapes) OR the timer
      // (exact transition shapes). All other room fields are frozen by the
      // affectedKeys() constraints in both branches.
      allow update: if signedIn()
        && (
             // ---- Phase 4: membership branch (with Phase 6 post-completion join block) ----
             ( request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['memberIds'])
               && request.resource.data.memberIds is list
               && (
                    (
                      resource.data.memberIds.size() == 1
                      && !(request.auth.uid in resource.data.memberIds)
                      && request.resource.data.memberIds.hasAll(resource.data.memberIds)
                      && request.auth.uid in request.resource.data.memberIds
                      && request.resource.data.memberIds.size() == 2
                      && resource.data.timer.status != 'completed' // Block joins during completion
                    )
                    ||
                    (
                      resource.data.memberIds.size() == 2
                      && request.auth.uid in resource.data.memberIds
                      && !(request.auth.uid in request.resource.data.memberIds)
                      && resource.data.memberIds.hasAll(request.resource.data.memberIds)
                      && request.resource.data.memberIds.size() == 1
                    )
                  )
             )
             ||
             // ---- Phase 5: timer branch ----
             ( request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['timer'])
               && request.auth.uid in resource.data.memberIds
               && request.resource.data.memberIds  == resource.data.memberIds
               && request.resource.data.ownerId    == resource.data.ownerId
               && request.resource.data.roomCode   == resource.data.roomCode
               && request.resource.data.createdAt  == resource.data.createdAt
               && request.resource.data.timer is map
               && timerValid(request.resource.data.timer, resource.data.timer)
             )
           );

      // A room may only be deleted as the paired half of a final-member
      // leave: the caller must be the sole current member, and the
      // roomCodes document must be deleted in the SAME batched write.
      allow delete: if signedIn()
        && resource.data.memberIds == [request.auth.uid]
        && !existsAfter(codePath(resource.data.roomCode));

      // ------------------------------------------------------------------
      // rooms/{roomId}/presence/{uid} — Real-time partner presence (Phase 7)
      // One document per member; the document ID is the member's UID.
      // ------------------------------------------------------------------
      match /presence/{uid} {

        // Members only — consistent with the room read rule above.
        allow read: if signedIn()
          && request.auth.uid in get(roomPath(roomId)).data.memberIds;

        // A member may create ONLY their own presence document, with exact
        // fields, a valid status, and a server-anchored lastSeen.
        allow create: if signedIn()
          && request.auth.uid in get(roomPath(roomId)).data.memberIds
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'status', 'lastSeen'])
          && request.resource.data.keys().hasAll(['uid', 'status', 'lastSeen'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status in ['online', 'idle', 'offline']
          && request.resource.data.lastSeen == request.time;

        // A member may update ONLY their own presence document; the uid field
        // is frozen both on the stored document and in the new write.
        allow update: if signedIn()
          && request.auth.uid in get(roomPath(roomId)).data.memberIds
          && uid == request.auth.uid
          && resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'status', 'lastSeen'])
          && request.resource.data.keys().hasAll(['uid', 'status', 'lastSeen'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status in ['online', 'idle', 'offline']
          && request.resource.data.lastSeen == request.time;

        // No legitimate client use yet; lifecycle cleanup is deferred to the
        // presence-lifecycle phase (room deletion already cascades implicitly:
        // subcollection docs become unreachable once the room doc is gone).
        allow delete: if false;
      }

      // ------------------------------------------------------------------
      // rooms/{roomId}/completions/{completionId} — Immutable completion evidence
      // ------------------------------------------------------------------
      match /completions/{completionId} {
        allow read: if signedIn()
          && (
               (exists(roomPath(roomId)) && request.auth.uid in get(roomPath(roomId)).data.memberIds)
               || request.auth.uid in resource.data.memberIds
             );

        // ONLY allowed when atomically paired with running -> completed timer transition
        allow create: if signedIn()
          && request.auth.uid in get(roomPath(roomId)).data.memberIds
          && request.resource.data.keys().hasOnly(['completedAt', 'durationSeconds', 'memberIds', 'roomCode'])
          && request.resource.data.keys().hasAll(['completedAt', 'durationSeconds', 'memberIds', 'roomCode'])
          && request.resource.data.completedAt == request.time
          && request.resource.data.durationSeconds == 1500
          && request.resource.data.memberIds == get(roomPath(roomId)).data.memberIds
          && request.resource.data.roomCode == get(roomPath(roomId)).data.roomCode
          && get(roomPath(roomId)).data.timer.status == 'running'
          && getAfter(roomPath(roomId)).data.timer.status == 'completed'
          && getAfter(roomPath(roomId)).data.timer.transitionedAt == request.time
          && request.resource.data.completedAt == getAfter(roomPath(roomId)).data.timer.transitionedAt;

        allow update: if false;
        allow delete: if false;
      }
    }

    // ------------------------------------------------------------------
    // users/{userId}/sessions/{sessionId} — Personal study session history
    // ------------------------------------------------------------------
    match /users/{userId}/sessions/{sessionId} {

      function isLegitimateCompletedSession(data) {
        let completion = get(completionPath(data.roomId, data.completionId));
        return completion != null
          && request.auth.uid in completion.data.memberIds
          && data.durationSeconds == completion.data.durationSeconds
          && data.durationSeconds == 1500
          && data.roomCode == completion.data.roomCode
          && data.completedAt == completion.data.completedAt;
      }

      allow read: if signedIn() && request.auth.uid == userId;

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
             'userId', 'roomId', 'completionId', 'roomCode', 'durationSeconds',
             'completedAt', 'createdAt'
           ])
        && request.resource.data.keys().hasAll([
             'userId', 'roomId', 'completionId', 'roomCode', 'durationSeconds',
             'completedAt', 'createdAt'
           ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.roomId is string
        && request.resource.data.completionId is string
        && request.resource.data.roomCode is string
        && request.resource.data.durationSeconds is int
        && request.resource.data.completedAt is timestamp
        && request.resource.data.createdAt == request.time
        && sessionId == request.resource.data.roomId + '_' + request.resource.data.completionId
        && isLegitimateCompletedSession(request.resource.data);

      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}

